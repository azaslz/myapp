const MEMO='メモ',USERS='users',SESSIONS='sessions',MEMO_HEADERS=['id','user_id','channel','timestamp','content','tags','updated_at'],USER_HEADERS=['id','email','password_hash','password_salt','verified_at','created_at'],SESSION_HEADERS=['id','user_id','kind','token_hash','expires_at','created_at'];
function doGet(){return out({success:true,status:'ok'})}function doPost(e){try{const r=JSON.parse(e.postData?.contents||'{}'),p=r.payload||{};switch(r.action){case'requestSignupOtp':return out(otp_(p));case'verifySignupOtp':return out(verify_(p));case'completeSignup':return out(complete_(p));case'login':return out(login_(p));case'logout':return out(logout_(p));case'list':return out(list_(p));case'create':return out(create_(p));case'update':return out(update_(p));case'delete':return out(remove_(p));default:return out({success:false,error:'invalid_action'})}}catch(e){console.error(e);return out({success:false,error:'server_error',detail:String(e.message||e)})}}
function sh_(n,h){const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(n);if(!s)throw Error('シート「'+n+'」が見つかりません。');const a=s.getRange(1,1,1,s.getLastColumn()).getValues()[0];if(h.some(x=>!a.includes(x)))throw Error('シート「'+n+'」の1行目に必要なカラムがありません。');return[s,a]}
function data_(n,h){const[s,heads]=sh_(n,h),v=s.getDataRange().getValues(),ix=Object.fromEntries(heads.map((x,i)=>[x,i]));return v.slice(1).map((r,i)=>{const x={row:i+2};heads.forEach(k=>x[k]=r[ix[k]] instanceof Date?r[ix[k]].toISOString():String(r[ix[k]]||''));return x})}function hash_(x){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,x).map(b=>('0'+(b&255).toString(16)).slice(-2)).join('')}function token_(){return Utilities.getUuid()+Utilities.getUuid().replace(/-/g,'')}function now_(){return new Date().toISOString()}function future_(m){return new Date(Date.now()+m*60000).toISOString()}function email_(v){return String(v||'').trim().toLowerCase()}function validEmail_(e){return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e)}
function otp_(p){const email=email_(p.email);if(!validEmail_(email))return{success:false,error:'invalid_email'};let u=data_(USERS,USER_HEADERS).find(x=>x.email===email);if(u&&u.verified_at)return{success:false,error:'already_registered'};if(!u){u={id:Utilities.getUuid(),email,password_hash:'',password_salt:'',verified_at:'',created_at:now_()};sh_(USERS,USER_HEADERS)[0].appendRow(USER_HEADERS.map(k=>u[k]))}const code=String(Math.floor(100000+Math.random()*900000));const s={id:Utilities.getUuid(),user_id:u.id,kind:'signup_otp',token_hash:hash_(code),expires_at:future_(10),created_at:now_()};sh_(SESSIONS,SESSION_HEADERS)[0].appendRow(SESSION_HEADERS.map(k=>s[k]));MailApp.sendEmail({to:email,subject:'Memo Flow 認証コード',body:'認証コードは '+code+' です。10分以内に入力してください。',htmlBody:'<p>認証コードは <b style="font-size:24px">'+code+'</b> です。</p><p>10分以内に入力してください。</p>'});return{success:true}}
function verify_(p){const email=email_(p.email),u=data_(USERS,USER_HEADERS).find(x=>x.email===email),s=u&&data_(SESSIONS,SESSION_HEADERS).filter(x=>x.user_id===u.id&&x.kind==='signup_otp'&&x.token_hash===hash_(String(p.code||''))&&x.expires_at>now_()).sort((a,b)=>b.created_at.localeCompare(a.created_at))[0];if(!s)return{success:false,error:'invalid_or_expired_code'};const t=token_();sh_(SESSIONS,SESSION_HEADERS)[0].appendRow([Utilities.getUuid(),u.id,'signup_verified',hash_(t),future_(15),now_()]);return{success:true,signupToken:t}}
function complete_(p){const u=auth_(p.signupToken,'signup_verified');if(!u||String(p.password||'').length<10)return{success:false,error:'invalid_signup_or_weak_password'};const salt=token_(),s=sh_(USERS,USER_HEADERS)[0];s.getRange(u.row,1,1,USER_HEADERS.length).setValues([[u.id,u.email,hash_(salt+'|'+p.password),salt,now_(),u.created_at]]);return{success:true,session:session_(u.id)}}function login_(p){const u=data_(USERS,USER_HEADERS).find(x=>x.email===email_(p.email)&&x.verified_at);if(!u||hash_(u.password_salt+'|'+String(p.password||''))!==u.password_hash)return{success:false,error:'invalid_credentials'};return{success:true,session:session_(u.id)}}function session_(id){const t=token_();sh_(SESSIONS,SESSION_HEADERS)[0].appendRow([Utilities.getUuid(),id,'login',hash_(t),future_(60*24*30),now_()]);return t}function auth_(t,kind='login'){if(!t)return null;const s=data_(SESSIONS,SESSION_HEADERS).find(x=>x.kind===kind&&x.token_hash===hash_(t)&&x.expires_at>now_());return s&&data_(USERS,USER_HEADERS).find(x=>x.id===s.user_id)}function logout_(p){const s=data_(SESSIONS,SESSION_HEADERS).find(x=>x.kind==='login'&&x.token_hash===hash_(p.session||''));if(s)sh_(SESSIONS,SESSION_HEADERS)[0].deleteRow(s.row);return{success:true}}
function mine_(p){const u=auth_(p.session);if(!u)throw Error('unauthorized');return u}function list_(p){const u=mine_(p),q=String(p.query||'').toLowerCase(),ts=p.tags||[],a=data_(MEMO,MEMO_HEADERS).filter(x=>x.user_id===u.id&&(!p.channel||x.channel===p.channel)&&(!q||x.content.toLowerCase().includes(q))&&ts.every(t=>x.tags.split(',').includes(t))).sort((a,b)=>b.timestamp.localeCompare(a.timestamp));return{success:true,items:a.slice(0,100).map(item_),hasMore:false,nextCursor:null}}function create_(p){const u=mine_(p);if(!p.channel||!String(p.content||'').trim())return{success:false,error:'invalid_payload'};const x={id:Utilities.getUuid(),user_id:u.id,channel:String(p.channel),timestamp:now_(),content:String(p.content).trim(),tags:(p.tags||[]).join(','),updated_at:''};sh_(MEMO,MEMO_HEADERS)[0].appendRow(MEMO_HEADERS.map(k=>x[k]));return{success:true,item:item_(x)}}function update_(p){const u=mine_(p),x=data_(MEMO,MEMO_HEADERS).find(x=>x.id===p.id&&x.user_id===u.id);if(!x)return{success:false,error:'not_found'};x.content=String(p.content||'').trim();x.tags=(p.tags||[]).join(',');x.updated_at=now_();sh_(MEMO,MEMO_HEADERS)[0].getRange(x.row,1,1,MEMO_HEADERS.length).setValues([MEMO_HEADERS.map(k=>x[k])]);return{success:true,item:item_(x)}}function remove_(p){const u=mine_(p),x=data_(MEMO,MEMO_HEADERS).find(x=>x.id===p.id&&x.user_id===u.id);if(!x)return{success:false,error:'not_found'};sh_(MEMO,MEMO_HEADERS)[0].deleteRow(x.row);return{success:true}}function item_(x){return{id:x.id,channel:x.channel,timestamp:x.timestamp,content:x.content,tags:x.tags?x.tags.split(',').filter(Boolean):[],updated_at:x.updated_at||null}}function out(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
