const MEMO='メモ',CHANNELS='channels',MEMO_HEADERS=['id','user_id','channel','timestamp','content','tags','updated_at'],CHANNEL_HEADERS=['name'];
function doGet(){return out({success:true,status:'ok'})}function doPost(e){try{const r=JSON.parse(e.postData?.contents||'{}'),p=r.payload||{};if(!auth_(p.token))return out({success:false,error:'unauthorized'});switch(r.action){case'unlock':return out({success:true});case'channels':return out(channels_(p));case'createChannel':return out(createChannel_(p));case'tags':return out(tags_(p));case'list':return out(list_(p));case'create':return out(create_(p));case'update':return out(update_(p));case'delete':return out(remove_(p));default:return out({success:false,error:'invalid_action'})}}catch(e){console.error(e);return out({success:false,error:'server_error',detail:String(e.message||e)})}}
function auth_(t){const secret=PropertiesService.getScriptProperties().getProperty('MEMO_APP_TOKEN');return!!secret&&String(t||'')===secret}
function sh_(n,h){const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(n);if(!s)throw Error('シート「'+n+'」が見つかりません。');const a=s.getRange(1,1,1,s.getLastColumn()).getValues()[0];if(h.some(x=>!a.includes(x)))throw Error('シート「'+n+'」の1行目に必要なカラムがありません。');return[s,a]}
function data_(n,h){const[s,heads]=sh_(n,h),v=s.getDataRange().getValues(),ix=Object.fromEntries(heads.map((x,i)=>[x,i]));return v.slice(1).map((r,i)=>{const x={row:i+2};heads.forEach(k=>x[k]=r[ix[k]] instanceof Date?r[ix[k]].toISOString():String(r[ix[k]]||''));return x})}function now_(){return new Date().toISOString()}
function channels_(p){const fromSheet=data_(CHANNELS,CHANNEL_HEADERS).map(x=>x.name).filter(Boolean),fromMemo=[...new Set(data_(MEMO,MEMO_HEADERS).map(x=>x.channel).filter(Boolean))],names=[...fromSheet];fromMemo.forEach(c=>{if(!names.includes(c))names.push(c)});return{success:true,channels:names}}function createChannel_(p){const name=String(p.name||'').trim();if(!name)return{success:false,error:'invalid_payload'};if(!data_(CHANNELS,CHANNEL_HEADERS).some(x=>x.name===name))sh_(CHANNELS,CHANNEL_HEADERS)[0].appendRow([name]);return{success:true,name}}function tags_(p){const names=[...new Set(data_(MEMO,MEMO_HEADERS).filter(x=>!p.channel||x.channel===p.channel).flatMap(x=>x.tags?x.tags.split(',').filter(Boolean):[]))].sort();return{success:true,tags:names}}function list_(p){const q=String(p.query||'').toLowerCase(),ts=p.tags||[],a=data_(MEMO,MEMO_HEADERS).filter(x=>(!p.channel||x.channel===p.channel)&&(!q||x.content.toLowerCase().includes(q))&&ts.every(t=>x.tags.split(',').includes(t))).sort((a,b)=>a.timestamp.localeCompare(b.timestamp)),sliced=a.length>100?a.slice(a.length-100):a;return{success:true,items:sliced.map(item_),hasMore:false,nextCursor:null}}function create_(p){if(!p.channel||!String(p.content||'').trim())return{success:false,error:'invalid_payload'};const x={id:Utilities.getUuid(),user_id:'',channel:String(p.channel),timestamp:now_(),content:String(p.content).trim(),tags:(p.tags||[]).join(','),updated_at:''};sh_(MEMO,MEMO_HEADERS)[0].appendRow(MEMO_HEADERS.map(k=>x[k]));return{success:true,item:item_(x)}}function update_(p){const x=data_(MEMO,MEMO_HEADERS).find(x=>x.id===p.id);if(!x)return{success:false,error:'not_found'};x.content=String(p.content||'').trim();x.tags=(p.tags||[]).join(',');x.updated_at=now_();sh_(MEMO,MEMO_HEADERS)[0].getRange(x.row,1,1,MEMO_HEADERS.length).setValues([MEMO_HEADERS.map(k=>x[k])]);return{success:true,item:item_(x)}}function remove_(p){const x=data_(MEMO,MEMO_HEADERS).find(x=>x.id===p.id);if(!x)return{success:false,error:'not_found'};sh_(MEMO,MEMO_HEADERS)[0].deleteRow(x.row);return{success:true}}function item_(x){return{id:x.id,channel:x.channel,timestamp:x.timestamp,content:x.content,tags:x.tags?x.tags.split(',').filter(Boolean):[],updated_at:x.updated_at||null}}function out(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
